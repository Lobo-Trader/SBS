---
title: Market Structure Indikator — Ebene 1: Pivot Engine
---
flowchart TD
    A([🕯️ Neuer Bar geschlossen]) --> B{3 abgeschlossene\nBars vorhanden?}
    B -- Nein --> A
    B -- Ja --> C{Mittlerer Bar\nist tiefstes Low\nder 3 Bars?}
    
    C -- Ja --> D[📍 Pivot Low Kandidat\nHL / LL / HL Muster]
    C -- Nein --> E{Mittlerer Bar\nist höchstes High\nder 3 Bars?}
    
    E -- Ja --> F[📍 Pivot High Kandidat\nLH / HH / LH Muster]
    E -- Nein --> G[❌ Kein Pivot\nBar wird ignoriert]

    D --> H{Liegt Pivot\ninnerhalb aktiver\nPx/Py Range?}
    F --> H

    H -- Ja --> I[❌ X-Pivot\nwird gefiltert]
    H -- Nein --> J{Pivot Low\noder High?}

    J -- Low --> K[✅ Valider Pivot Low\nan Struktur Engine\nübergeben]
    J -- High --> L[✅ Valider Pivot High\nan Struktur Engine\nübergeben]

    style A fill:#2d2d2d,color:#fff
    style D fill:#c8e6c9,color:#000
    style F fill:#c8e6c9,color:#000
    style I fill:#ffcdd2,color:#000
    style G fill:#ffcdd2,color:#000
    style K fill:#a5d6a7,color:#000
    style L fill:#a5d6a7,color:#000
